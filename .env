# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Ollama's built-in OpenAI-compatible API (no separate vLLM server needed)
VLLM_BASE_URL=http://localhost:11434/v1
VLLM_API_KEY=not-needed

# Exact Ollama model names confirmed running on this machine
ANALYST_ADAPTER=vultix-analyst:latest
EXECUTOR_ADAPTER=vultix-executor:latest

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=vultix-change-this-in-production

# ── Database ───────────────────────────────────────────────────────────────────
# Format: mysql+aiomysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
MYSQL_URL=mysql+aiomysql://root:2006@localhost:3306/vultix


# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
